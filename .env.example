# Database
DATABASE_URL=postgresql+asyncpg://cruisealert:cruisealert@localhost:5432/cruisealert

# Redis
REDIS_URL=redis://localhost:6379/0

# RapidAPI
RAPIDAPI_KEY=your_key_here
RAPIDAPI_HOST=cruise-prices.p.rapidapi.com

# Auth
JWT_SECRET=change_me_to_64_random_chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=alerts@cruisealert.io
SENDGRID_PRICE_DROP_TEMPLATE_ID=d-...
SENDGRID_BACK_IN_STOCK_TEMPLATE_ID=d-...
SENDGRID_AVAIL_WARNING_TEMPLATE_ID=d-...
SENDGRID_VERIFY_EMAIL_TEMPLATE_ID=d-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
TWILIO_VERIFY_SERVICE_SID=VA...

# App
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
